# Public base URL. Used for canonical, OG, sitemap, robots.
# In Vercel production, set this explicitly to https://www.lasahtx.com.
# Leave unset in preview/dev to keep SEO URLs pointed at the production domain.
NEXT_PUBLIC_SITE_URL=

# CRM/CMS feeds from Hospitality OS. Defaults point to production CRM when unset.
HOSPITALITY_OS_MENU_FEED_URL=https://hospitality-os-core.vercel.app/api/public/menu?brand=lasa-htx
HOSPITALITY_OS_POPUPS_FEED_URL=https://hospitality-os-core.vercel.app/api/public/popups?brand=lasa-htx

# Resend transactional email (catering inquiry forms land in a later session).
RESEND_API_KEY=
# Where form submissions are emailed. Also used as reply-to for customer
# confirmation emails. Defaults to both Paolo addresses when unset.
CONTACT_EMAIL_TO=paolo@lasahtx.com,paolo@heardhospitalitygroup.com

# Pop-ups waitlist provider — Beehiiv / ConvertKit / Mailchimp, TBD.
WAITLIST_PROVIDER_API_KEY=
WAITLIST_PROVIDER_LIST_ID=

# Stripe Checkout Sessions for /meal-prep.
# Use test keys (sk_test_..., whsec_...) pre-launch; swap to live at cutover.
# Both set in Vercel Project → Settings → Environment Variables (Production
# and Preview scopes recommended for testing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
